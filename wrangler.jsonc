{
  "$schema":"node_modules/wrangler/config-schema.json",
  "name":"dutch",
  "account_id":"5ee86c3f64748099a059a3df10113ef0",
  "main":"apps/worker/src/index.ts",
  "compatibility_date":"2025-10-01",
  "assets":{"directory":"./dist","binding":"ASSETS","not_found_handling":"single-page-application","run_worker_first":["/api/*"]},
  "durable_objects":{"bindings":[{"name":"ROOMS","class_name":"GameRoom"}]},
  "migrations":[{"tag":"v1","new_sqlite_classes":["GameRoom"]}],
  "ratelimits":[{"name":"API_LIMITER","namespace_id":"1001","simple":{"limit":120,"period":60}},{"name":"TURN_LIMITER","namespace_id":"1002","simple":{"limit":12,"period":60}}],
  "vars":{"ROOM_TTL_HOURS":"24","RECONNECT_GRACE_SECONDS":"120","TURN_KEY_ID":"fdf3cb1cb71a02d2d098567b5be263ed"},
  "observability":{"enabled":true}
}
